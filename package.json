{
  "name": "no-guess-minesweeper",
  "version": "0.1.0",
  "description": "Generate Minesweeper boards that are always solvable without guessing. Used in production by Campo Minado (campominado.com).",
  "keywords": [
    "minesweeper",
    "no-guess",
    "solvable",
    "puzzle",
    "game"
  ],
  "license": "MIT",
  "author": "lannyone",
  "homepage": "https://campominado.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lannyone/no-guess-minesweeper.git"
  },
  "bugs": {
    "url": "https://github.com/lannyone/no-guess-minesweeper/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench": "node bench/bench.js",
    "check": "npm test && npm run typecheck && npm run build && node test/exports.mjs"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
